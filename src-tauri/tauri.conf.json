{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMD Fan Control",
  "version": "0.1.0-alpha.4",
  "identifier": "com.itsmrma.amdfancontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "AMD Fan Control",
      "width": 920,
      "height": 790,
      "minWidth": 680,
      "minHeight": 650,
      "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRkI0NTA4NzhCNDhEMUMKUldRY2piUjRDRVg3Lzhra3JTemFJWWlXZmwxVGtoOW1ydTNSOFdLNmxBQ05FVHliVERvbkhpeWcK",
      "endpoints": ["https://github.com/itsmrma/amd-fan-control/releases/download/updater/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Lightweight AMD GPU fan curve control",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" },
      "wix": { "language": "en-US", "version": "0.1.0.4" }
    }
  }
}

